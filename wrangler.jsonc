{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-competition-scoring-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "live-scoring-db",
      "database_id": "d5320047-27ef-40ee-9cd2-d568444c5b79"
    }
  ]
}