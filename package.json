{
  "name": "live-competition-scoring-app",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "d1:migrate:local": "wrangler d1 execute live-scoring-db --local --file=src/db/schema.sql -y",
    "d1:migrate:remote": "wrangler d1 execute live-scoring-db --remote --file=src/db/schema.sql -y"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.8",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wrangler": "^4.151.0"
  }
}
